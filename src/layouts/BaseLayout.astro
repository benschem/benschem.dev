---
import BaseHead from "../components/BaseHead.astro";
import "../styles/reset.css";
import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: "website" | "article";
  pubDate?: Date;
  updatedDate?: Date;
  noIndex?: boolean;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...props} />
    <slot name="head" />
  </head>
  <body>
    <!-- Sunburst is inline so its gradient stops can read theme tokens.
         Data-URL backgrounds can't access the host document's CSS variables. -->
    <svg
      class="sunburst"
      aria-hidden="true"
      viewBox="0 0 800 800"
      preserveAspectRatio="xMidYMid slice"
    >
      <defs>
        <radialGradient
          id="burst-inner"
          cx="400"
          cy="400"
          r="50%"
          gradientUnits="userSpaceOnUse"
        >
          <stop offset="0" stop-color="var(--burst-centre)"></stop>
          <stop offset="1" stop-color="var(--burst-mid)"></stop>
        </radialGradient>
        <radialGradient
          id="burst-outer"
          cx="400"
          cy="400"
          r="70%"
          gradientUnits="userSpaceOnUse"
        >
          <stop offset="0" stop-color="var(--burst-centre)"></stop>
          <stop offset="1" stop-color="var(--burst-edge)"></stop>
        </radialGradient>
      </defs>
      <rect fill="url(#burst-inner)" width="800" height="800"></rect>
      <g fill-opacity=".8">
        <path
          fill="url(#burst-outer)"
          d="M998.7 439.2c1.7-26.5 1.7-52.7 0.1-78.5L401 399.9c0 0 0-0.1 0-0.1l587.6-116.9c-5.1-25.9-11.9-51.2-20.3-75.8L400.9 399.7c0 0 0-0.1 0-0.1l537.3-265c-11.6-23.5-24.8-46.2-39.3-67.9L400.8 399.5c0 0 0-0.1-0.1-0.1l450.4-395c-17.3-19.7-35.8-38.2-55.5-55.5l-395 450.4c0 0-0.1 0-0.1-0.1L733.4-99c-21.7-14.5-44.4-27.6-68-39.3l-265 537.4c0 0-0.1 0-0.1 0l192.6-567.4c-24.6-8.3-49.9-15.1-75.8-20.2L400.2 399c0 0-0.1 0-0.1 0l39.2-597.7c-26.5-1.7-52.7-1.7-78.5-0.1L399.9 399c0 0-0.1 0-0.1 0L282.9-188.6c-25.9 5.1-51.2 11.9-75.8 20.3l192.6 567.4c0 0-0.1 0-0.1 0l-265-537.3c-23.5 11.6-46.2 24.8-67.9 39.3l332.8 498.1c0 0-0.1 0-0.1 0.1L4.4-51.1C-15.3-33.9-33.8-15.3-51.1 4.4l450.4 395c0 0 0 0.1-0.1 0.1L-99 66.6c-14.5 21.7-27.6 44.4-39.3 68l537.4 265c0 0 0 0.1 0 0.1l-567.4-192.6c-8.3 24.6-15.1 49.9-20.2 75.8L399 399.8c0 0 0 0.1 0 0.1l-597.7-39.2c-1.7 26.5-1.7 52.7-0.1 78.5L399 400.1c0 0 0 0.1 0 0.1l-587.6 116.9c5.1 25.9 11.9 51.2 20.3 75.8l567.4-192.6c0 0 0 0.1 0 0.1l-537.3 265c11.6 23.5 24.8 46.2 39.3 67.9l498.1-332.8c0 0 0 0.1 0.1 0.1l-450.4 395c17.3 19.7 35.8 38.2 55.5 55.5l395-450.4c0 0 0.1 0 0.1 0.1L66.6 899c21.7 14.5 44.4 27.6 68 39.3l265-537.4c0 0 0.1 0 0.1 0L207.1 968.3c24.6 8.3 49.9 15.1 75.8 20.2L399.8 401c0 0 0.1 0 0.1 0l-39.2 597.7c26.5 1.7 52.7 1.7 78.5 0.1L400.1 401c0 0 0.1 0 0.1 0l116.9 587.6c25.9-5.1 51.2-11.9 75.8-20.3L400.3 400.9c0 0 0.1 0 0.1 0l265 537.3c23.5-11.6 46.2-24.8 67.9-39.3L400.5 400.8c0 0 0.1 0 0.1-0.1l395 450.4c19.7-17.3 38.2-35.8 55.5-55.5l-450.4-395c0 0 0-0.1 0.1-0.1L899 733.4c14.5-21.7 27.6-44.4 39.3-68l-537.4-265c0 0 0-0.1 0-0.1l567.4 192.6c8.3-24.6 15.1-49.9 20.2-75.8L401 400.2c0 0 0-0.1 0-0.1L998.7 439.2z"
        ></path>
      </g>
    </svg>

    <a class="skip-link" href="#main">Skip to content</a>

    <Header />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <!-- Konami listener — ↑↑↓↓←→←→BA unlocks the Nintendo theme. Just a
         stub: the boot sequence, chime, and reveal live in
         /js/nintendo-boot.js and are only fetched on success. Never calls
         preventDefault, so arrows still scroll and typing is untouched. -->
    <script is:inline>
      {
        const seq =
          "ArrowUp ArrowUp ArrowDown ArrowDown ArrowLeft ArrowRight ArrowLeft ArrowRight b a".split(
            " ",
          );
        let i = 0;
        addEventListener("keydown", (e) => {
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          const k = e.key.length === 1 ? e.key.toLowerCase() : e.key;
          i = k === seq[i] ? i + 1 : k === seq[0] ? 1 : 0;
          if (i === seq.length) {
            i = 0;
            import("/js/nintendo-boot.js").then((m) => m.boot());
          }
        });
      }
    </script>

    <!-- Repaint the sunburst when the OS flips light/dark. Its gradient stops
         read theme tokens via var(), which do recompute on a system scheme
         change — but the SVG gradient paint server isn't invalidated on that
         path, so the burst keeps its old colours while the rest of the page
         updates. Re-asserting each stop-color is a direct DOM mutation that
         forces the gradient (and the shapes filling from it) to re-render; the
         existing stop-color transition turns it into a smooth crossfade. -->
    <script is:inline>
      matchMedia("(prefers-color-scheme: dark)").addEventListener(
        "change",
        () => {
          for (const stop of document.querySelectorAll(".sunburst stop")) {
            const color = stop.getAttribute("stop-color");
            stop.setAttribute("stop-color", "transparent");
            stop.setAttribute("stop-color", color);
          }
        },
      );
    </script>
  </body>
</html>

<style>
  body {
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    grid-template-columns: minmax(0, 1fr);
    justify-items: stretch;
    /* Fallback if the inline sunburst fails to render. */
    background-color: var(--accent);
  }

  /* Fixed full-viewport backdrop — z-index: -1 paints it after body's
     background but before in-flow children, so header/main/footer cover it
     where they sit and the chunky border strips show it through. */
  .sunburst {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }

  /* One-time bloom on load: the rays fade up and settle from slightly
     oversized to flush. Scale stays >= 1 so the viewport is always covered;
     the solid --accent body background shows through underneath while it
     fades, reading as the burst blooming out of the accent. */
  @media (prefers-reduced-motion: no-preference) {
    .sunburst {
      animation: burst-in 1.1s ease-out both;
    }
  }

  @keyframes burst-in {
    from {
      opacity: 0;
      transform: scale(1.08);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  main {
    background-color: var(--surface-reading);
    background-clip: padding-box;
    border-left: var(--border-accent) solid transparent;
    border-bottom: var(--border-thin) solid transparent;
    /* Same padding-box trick as the header: add each side's border width back so
       the corners against the sunburst (left strip + thin bottom) round cleanly
       by 1rem rather than being eaten by the transparent border. */
    border-top-left-radius: calc(1rem + var(--border-accent)) 1rem;
    border-bottom-left-radius: calc(1rem + var(--border-accent))
      calc(1rem + var(--border-thin));
  }
</style>
