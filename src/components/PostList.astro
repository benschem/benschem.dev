---
import { getCollection } from "astro:content";

interface Props {
  limit?: number;
}

const { limit } = Astro.props;

const allPosts = (
  await getCollection("posts", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const posts = limit ? allPosts.slice(0, limit) : allPosts;
const hasMore = limit !== undefined && allPosts.length > limit;

const dateFormat = new Intl.DateTimeFormat("en-AU", { dateStyle: "long" });
---

<div class="posts">
  {
    posts.length === 0 ? (
      <p>Nothing here yet.</p>
    ) : (
      <ol class="post-list" reversed>
        {posts.map((post, i) => (
          <li style={`--i:${i}`}>
            <a href={`/posts/${post.id}`}>
              <time datetime={post.data.published.toISOString()}>
                {dateFormat.format(post.data.published)}
              </time>
              <h2>
                {post.data.title}
                <span class="go" aria-hidden="true">
                  &rarr;
                </span>
              </h2>
              <p>{post.data.description}</p>
            </a>
          </li>
        ))}
      </ol>
    )
  }
  {
    hasMore && (
      <a class="view-all" href="/posts">
        View all posts <span aria-hidden="true">&rarr;</span>
      </a>
    )
  }
</div>

<style>
  /* Flush-left list: rows are separated by hairline rules and padding only,
     so the content lines up with whatever heading/intro sits above it. */
  .post-list {
    list-style: none;
    padding: 0;

    & li {
      border-block-start: 1px solid
        color-mix(in oklch, var(--accent) 28%, transparent);
    }

    & li:last-child {
      border-block-end: 1px solid
        color-mix(in oklch, var(--accent) 28%, transparent);
    }

    & a {
      display: block;
      padding-block: 1.5rem;
      text-decoration: none;
      color: var(--ink-body);
    }

    & h2 {
      margin-block: 0.35rem 0;
      transition: color 0.2s ease;
    }

    /* The arrow nudges out of the title on hover/focus. */
    & .go {
      display: inline-block;
      margin-inline-start: 0.4rem;
      color: var(--accent);
      transition: transform 0.2s ease;
    }

    & a:hover h2,
    & a:focus-visible h2 {
      color: var(--accent);
    }

    & a:hover .go,
    & a:focus-visible .go {
      transform: translateX(0.3rem);
    }

    & p {
      margin-block-start: 0.4rem;
    }

    & time {
      display: block;
      font-size: var(--font-size-fluid--1);
      color: var(--alt);
      font-variant-caps: all-small-caps;
      letter-spacing: 0.05em;
    }
  }

  .view-all {
    display: inline-block;
    margin-block-start: 1.75rem;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.05em;
    color: var(--ink-heading);
    text-decoration: none;
  }

  .view-all:hover {
    text-decoration: underline;
  }

  /* Rows cascade in on load, each delayed by its index (--i set inline).
     Time-based rather than scroll-driven so the entrance is visible even
     when the list sits at the top of the page (e.g. the /posts index).
     Gated under no-preference, so opacity:0 only applies when it animates. */
  @media (prefers-reduced-motion: no-preference) {
    .post-list li {
      opacity: 0;
      animation: rise 0.6s cubic-bezier(0.21, 0.6, 0.35, 1) both;
      animation-delay: calc(var(--i, 0) * 0.06s);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
