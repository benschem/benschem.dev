---
import { Image } from "astro:assets";
import profilePhoto from "../../public/images/profile-photo-ben-schembri.png";

const pathname = Astro.url.pathname;

const links = [
  { href: "/", label: "Home" },
  { href: "/posts", label: "Posts" },
  { href: "/connect", label: "Connect" },
];

const isCurrent = (href: string) =>
  href === "/"
    ? pathname === "/"
    : pathname === href || pathname.startsWith(href + "/");

// interface Props {
//   title: string;
//   description: string;
//   image?: string;
//   ogType?: "website" | "article";
//   pubDate?: Date;
//   updatedDate?: Date;
//   noIndex?: boolean;
// }

// const {
//   title,
//   description,
//   image = "/og-default.png",
//   ogType = "website",
//   pubDate,
//   updatedDate,
//   noIndex = false,
// } = Astro.props;
---

<header>
  <div>
    <figure class="avatar">
      <Image src={profilePhoto} alt="Ben Schembri" width={200} height={200} />
    </figure>

    <div class="site-title">
      <a href="/" rel="home">Ben Schembri</a>
      <strong>👨🏻‍💻 Software Engineer</strong>
      <p>📍 Melbourne, Australia</p>
    </div>
  </div>

  <nav>
    <ul>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  header {
    background-color: var(--surface-raised);
    background-clip: padding-box;
    display: flex;
    gap: 1rem 1rem;
    flex-wrap: wrap;
    justify-content: space-between;
    border-top: var(--border-thick) solid transparent;
    border-right: var(--border-accent) solid transparent;
    border-bottom: var(--border-thick) solid transparent;
    /* The visible surface is the padding box (background-clip: padding-box), so
       border-radius rounds the *border* box and the padding corner only rounds
       by (radius − border-width). The right border is var(--border-accent), well
       over 1rem, so a plain 1rem radius gets fully eaten and the corner reads as
       sharp. Add the border width back per axis (x = inline, y = block) so the
       visible corner is a clean 1rem. */
    border-top-right-radius: calc(1rem + var(--border-accent))
      calc(1rem + var(--border-thick));
    border-bottom-right-radius: calc(1rem + var(--border-accent))
      calc(1rem + var(--border-thick));
    padding: 1rem;

    & > div {
      display: flex;
      gap: 0 1rem;
      flex-wrap: wrap;
      align-items: center;
    }
  }

  nav {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-inline: 1rem;

    & ul {
      list-style-type: symbols(cyclic "🏡" "📚" "📞");
      & li {
        margin-block-end: 0.25rem;
        & a[aria-current="page"] {
          text-decoration-color: var(--alt-strong);
        }
      }
    }
  }

  .avatar {
    aspect-ratio: 1 / 1;
    max-width: 140px;
    padding: 0.5rem;
    border-radius: 0.25rem;
    background: radial-gradient(
      circle at center,
      var(--burst-centre),
      var(--burst-mid)
    );
  }

  .avatar img {
    aspect-ratio: 1 / 1;
    border-radius: 0.25rem;
    width: 100%;
    height: auto;
  }

  .site-title {
    padding-inline-start: 1rem;
  }

  .site-title > * {
    display: block;
  }

  .site-title a {
    margin-block-end: 1rem;
    text-decoration: none;
    font-family: var(--font-classical-humanist);
    font-weight: 900;
    color: var(--ink-body);
    text-wrap: balance;
    font-size: var(--font-size-fluid-1);
  }
</style>
