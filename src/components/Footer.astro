---
import MotionSwitcher from "./MotionSwitcher.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";

const year = new Date().getFullYear();
---

<footer>
  <nav aria-label="Footer">
    <ul>
      <li><a href="#top">↑ Back to top</a></li>
      <li><a href="/privacy">Privacy</a></li>
      <li><a href="/ai">AI Policy</a></li>
      <li><a href="/uses">Uses</a></li>
      <li>
        <a
          href="https://github.com/benschem/benschem.dev"
          target="_blank"
          rel="noopener noreferrer">View Source</a
        >
      </li>
    </ul>
  </nav>

  <div class="end">
    <ThemeSwitcher />
    <MotionSwitcher />
    <p class="copyright">&copy; {year} Ben Schembri</p>
  </div>
</footer>

<style>
  footer {
    margin-bottom: var(--border-thin);
    background-color: var(--surface-raised);
    padding: 2rem 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
    justify-content: space-between;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .end {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .copyright {
    margin: 0;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.05em;
  }
</style>
