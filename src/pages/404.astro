---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found -- Ben Schembri"
  description="This page doesn't exist."
  noIndex
>
  <div class="not-found">
    <header class="page-head">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="lead">
        There's nothing at this address. The page may have moved, or it may have
        never existed at all.
      </p>
      <p class="links">
        <a class="back" href="/"
          ><span class="go" aria-hidden="true">&larr;</span> Back to the homepage</a
        > or <a href="/posts">browse the posts</a>.
      </p>
    </header>
  </div>
</BaseLayout>

<style>
  .not-found {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
    padding-block: clamp(2.5rem, 8vh, 5rem);
    line-height: 1.7;
  }

  .eyebrow {
    font-family: var(--font-system-ui);
    font-size: var(--font-size-fluid--1);
    font-weight: 700;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-block-end: 0.5rem;
  }

  .lead {
    font-size: var(--font-size-fluid-0);
    margin-block-start: 0.25rem;
    max-width: 52ch;
  }

  .links {
    margin-block-start: 1.5rem;
  }

  /* The arrow nudges out of the link on hover/focus, like the post list. */
  .back .go {
    display: inline-block;
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  .back:hover .go,
  .back:focus-visible .go {
    transform: translateX(-0.3rem);
  }

  /* Matches the homepage hero stagger so navigating between pages feels
     continuous. Time-based, so opacity:0 only applies when it will animate. */
  @media (prefers-reduced-motion: no-preference) {
    .page-head > * {
      opacity: 0;
      animation: rise 0.7s cubic-bezier(0.21, 0.6, 0.35, 1) both;
    }
    .page-head > :nth-child(1) {
      animation-delay: 0.1s;
    }
    .page-head > :nth-child(2) {
      animation-delay: 0.2s;
    }
    .page-head > :nth-child(3) {
      animation-delay: 0.32s;
    }
    .page-head > :nth-child(4) {
      animation-delay: 0.44s;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
