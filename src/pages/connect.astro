---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Connect with Ben Schembri"
  description="Ways to get in touch with or follow on the web."
>
  <div class="connect">
    <h1>Connect</h1>

    <ul class="stack-small">
      <li>
        <a href="https://rocketzip.com.au" target="_blank" rel="noopener">
          Rocketzip
        </a>
      </li>
      <li>
        <a
          href="https://au.linkedin.com/in/benschembri"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>
      </li>
      <li>
        <a
          href="https://github.com/benschem"
          target="_blank"
          rel="noopener noreferrer"
        >
          Github
        </a>
      </li>
      <li>
        <a
          href="https://x.com/benschem"
          target="_blank"
          rel="noopener noreferrer"
        >
          X / Twitter
        </a>
      </li>
      <li>
        <a
          href="https://www.instagram.com/benschem/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram
        </a>
      </li>
      <li>
        <a
          href="https://www.facebook.com/schembri.ben"
          target="_blank"
          rel="noopener noreferrer"
        >
          Facebook
        </a>
      </li>
      <li>
        <a
          href="https://open.spotify.com/user/schem35?si=58f26190ffa64a53"
          target="_blank"
          rel="noopener noreferrer"
        >
          Spotify
        </a>
      </li>
    </ul>
  </div>
</BaseLayout>

<style>
  .connect {
    margin-inline: auto;
    padding-inline: 1rem;
    padding-block: 4rem;
    max-width: 96ch;
  }
</style>
