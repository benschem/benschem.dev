---
import BaseLayout from "../layouts/BaseLayout.astro";

const updated = new Date("2026-06-03");
const dateFormat = new Intl.DateTimeFormat("en-AU", { dateStyle: "long" });

const sections: {
  title: string;
  items: { label?: string; name: string; note?: string; href?: string }[];
}[] = [
  {
    title: "Software",
    items: [
      { label: "Editing code", name: "VSCode", note: "I've tried to switch to Neovim but it didn't stick" },
      { label: "Shell", name: "Zsh", note: "No plugin manager - all handwritten. Starship prompt", href: "https://github.com/benschem/dotfiles" },
      { label: "Browsing", name: "Safari", note: "Keychain, Handoff and autofilling confirmation codes keep me here" },
      { label: "Debugging", name: "Firefox", note: "Vastly prefer the dev tools compared to Safari" },
      { label: "Chatting", name: "Slack", note: "Please don't make me use Teams" },
    ],
  },
  {
    title: "Hardware",
    items: [
      { label: "Laptop", name: "Macbook", note: "Windows is hot garbage and Apple Silicon is amazing" },
      { label: "Desktop", name: "Custom build", note: "Ageing gaming and media editing machine that dual boots Windows and Linux" },
      { label: "Keyboard", name: "Keychron K3", note: "I'm eyeing off a split keyboard next" },
      { label: "Pointer", name: "Apple Trackpad", note: "I'm just a trackpad guy, the gestures are so good" },
    ],
  },
];
---

<BaseLayout
  title="Uses -- Ben Schembri"
  description="The hardware, software, and tools I use day to day."
>
  <article class="uses">
    <header class="page-head">
      <p class="eyebrow">
        Last updated <time datetime={updated.toISOString()}
          >{dateFormat.format(updated)}</time
        >
      </p>
      <h1>Uses</h1>
      <p class="lead">
        The stuff I use on the daily. Inspired by <a
          href="https://uses.tech"
          rel="noopener">uses.tech</a
        >.
      </p>
    </header>

    {
      sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          <ul class="items">
            {section.items.map((item) => (
              <li>
                <span class="head">
                  {item.label && <span class="label">{item.label}</span>}
                  <span class="name">
                    {item.href ? (
                      <a href={item.href} target="_blank" rel="noopener noreferrer">
                        {item.name}
                      </a>
                    ) : (
                      item.name
                    )}
                  </span>
                </span>
                {item.note && <span class="note">{item.note}</span>}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </article>
</BaseLayout>

<style>
  .uses {
    max-width: 64ch;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
    padding-block: clamp(2.5rem, 8vh, 5rem);
    line-height: 1.7;
  }

  .page-head {
    margin-block-end: 2.5rem;
  }

  .eyebrow {
    font-family: var(--font-system-ui);
    font-size: var(--font-size-fluid--1);
    font-weight: 700;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-block-end: 0.5rem;
  }

  .lead {
    font-size: var(--font-size-fluid-0);
    margin-block-start: 0.25rem;
    max-width: 52ch;
  }

  h2 {
    margin-block-start: 2.5em;
    margin-block-end: 0.5em;
  }

  .items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }

  .items li {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }

  /* Label sits above the name, eyebrow-style, matching the page header. */
  .head {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .label {
    font-family: var(--font-system-ui);
    font-size: var(--font-size-fluid--1);
    font-weight: 700;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .name {
    font-family: var(--font-classical-humanist);
    font-weight: 700;
    font-size: var(--font-size-fluid-0);
    color: var(--ink-body);
  }

  .note {
    font-size: var(--font-size-fluid--1);
    color: var(--alt);
  }

  /* Matches the homepage hero stagger so navigating between pages feels
     continuous. Time-based, so opacity:0 only applies when it will animate. */
  @media (prefers-reduced-motion: no-preference) {
    .page-head > * {
      opacity: 0;
      animation: rise 0.7s cubic-bezier(0.21, 0.6, 0.35, 1) both;
    }
    .page-head > :nth-child(1) {
      animation-delay: 0.1s;
    }
    .page-head > :nth-child(2) {
      animation-delay: 0.2s;
    }
    .page-head > :nth-child(3) {
      animation-delay: 0.32s;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
