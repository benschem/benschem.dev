---
import PostList from "../components/PostList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Ben Schembri"
  description="Profile for Ben Schembri, a software engineer from Melbourne Australia."
>
  <div class="home">
    <section class="hero" aria-labelledby="hero-title">
      <p class="eyebrow">Curious · Opinionated · Hands&nbsp;On</p>
      <h1 id="hero-title">I go down the rabbit holes, then write about it.</h1>
      <p class="lead">
        Sometimes on purpose, sometimes by accident, I keep asking questions
        until I really understand. I try to do things the hard way at least
        once, so that the next time I can take the shortcut knowing the
        trade-offs.
      </p>
      <div class="buttons">
        <a class="btn btn-primary" href="/posts">Read my blog</a>
        <a class="btn btn-secondary" href="/connect">Get in touch</a>
      </div>
    </section>

    <section class="aside scroll-reveal" aria-labelledby="aside-title">
      <h2 id="aside-title">About me</h2>
      <h3>My day job</h3>
      <p>
        In my day job I work in the energy sector, helping to improve and
        maintain the software infrastructure for a large network of hardware
        connected devices. Our product is used by consumers and businesses, as
        well as our own internal teams.
      </p>
      <h3>On the side</h3>
      <p>
        I run a boutique studio building custom e-commerce stores for Australian
        fashion and lifestyle brands that have outgrown Shopify. Plus I do the
        odd marketing site.
      </p>
      <p>
        And I sometimes teach web development at a coding bootcamp, taking
        students from the basics of programming through to shipping their first
        full-stack web apps.
      </p>
    </section>

    <section class="latest scroll-reveal" aria-labelledby="latest-title">
      <h2 id="latest-title">Latest writing</h2>
      <PostList limit={3} />
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    max-width: 68ch;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
    padding-block: clamp(2.5rem, 8vh, 5rem);
    /* Clip only the horizontal axis so the hero's decorative burst can bleed
       off the right edge without ever spawning a horizontal scrollbar. `clip`
       (unlike `hidden`) doesn't create a scroll container, so the page scroll
       and the below-fold view() timelines keep working. */
    overflow-x: clip;
  }

  /* ---- Hero ---------------------------------------------------------- */

  .hero {
    position: relative;
    /* isolate so the decorative ::before can sit at z-index -1 *within* the
       hero (behind the text) without dropping behind main's opaque surface. */
    isolation: isolate;
    padding-block-end: clamp(3rem, 9vh, 5.5rem);
    margin-block-end: clamp(2.5rem, 7vh, 4rem);
    border-block-end: 1px solid
      color-mix(in oklch, var(--accent) 35%, transparent);
  }

  /* A CSS echo of the page's sunburst: thin radial rays fanning out of the
     top-right, masked to fade before they reach the text. Pure decoration. */
  .hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -45% -15% auto auto;
    width: min(80vw, 34rem);
    aspect-ratio: 1;
    background: repeating-conic-gradient(
      from -12deg at 50% 50%,
      color-mix(in oklch, var(--accent) 24%, transparent) 0deg 2.6deg,
      transparent 2.6deg 11deg
    );
    -webkit-mask-image: radial-gradient(
      circle at 50% 50%,
      #000,
      transparent 64%
    );
    mask-image: radial-gradient(circle at 50% 50%, #000, transparent 64%);
    opacity: 0.55;
    pointer-events: none;
  }

  .eyebrow {
    font-family: var(--font-system-ui);
    font-size: var(--font-size-fluid--1);
    font-weight: 700;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-block-end: 0.75rem;
  }

  .hero h1 {
    font-size: var(--font-size-fluid-5);
    line-height: 1.05;
    margin-block-end: 1.25rem;
    color: var(--ink-body);
  }

  .lead {
    font-size: var(--font-size-fluid-1);
    line-height: 1.45;
    max-width: 52ch;
    margin-block-end: 2rem;
  }

  .hero .buttons {
    flex-wrap: wrap;
  }

  /* ---- Lower sections ------------------------------------------------ */

  .aside {
    margin-block-end: clamp(2.5rem, 7vh, 4rem);
  }

  .aside p + p {
    margin-block-start: 1rem;
  }

  /* Section title sits a little closer to its first subheading. */
  .aside > h2 {
    margin-block-end: 1.25rem;
  }

  /* Subheadings get air above them, except the first one (which follows the
     section's h2 and is handled by the h2's margin-block-end above). */
  .aside p + h3 {
    margin-block-start: 2rem;
  }

  .latest > h2 {
    margin-block-end: 0.75rem;
  }

  /* ---- Choreography -------------------------------------------------- */

  @media (prefers-reduced-motion: no-preference) {
    /* Hero: a time-based stagger that always runs, so opacity:0 is safe. */
    .hero > * {
      opacity: 0;
      animation: rise 0.7s cubic-bezier(0.21, 0.6, 0.35, 1) both;
    }
    .hero > :nth-child(1) {
      animation-delay: 0.12s;
    }
    .hero > :nth-child(2) {
      animation-delay: 0.22s;
    }
    .hero > :nth-child(3) {
      animation-delay: 0.34s;
    }
    .hero > :nth-child(4) {
      animation-delay: 0.46s;
    }

    /* Below-fold: scroll-driven reveal. Gated behind @supports so browsers
       without view() timelines never hide the content (no JS fallback). */
    @supports (animation-timeline: view()) {
      .scroll-reveal {
        opacity: 0;
        animation: rise linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 22%;
      }
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
