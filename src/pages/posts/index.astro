---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
---

<BaseLayout
  title="Posts -- Ben Schembri"
  description="Writing by Ben Schembri."
>
  <div class="posts-index">
    <header class="page-head">
      <h1>Posts</h1>
      <p class="lead">
        Write-ups from the rabbit holes. How things actually work under the
        abstractions, how I built what I built and why I made the choices I did,
        and notes and references for future-me.
      </p>
    </header>

    <PostList />
  </div>
</BaseLayout>

<style>
  .posts-index {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
    padding-block: clamp(2.5rem, 8vh, 5rem);
    /* The list rows cascade in behind the lead (read inside PostList)
       rather than block-rising with the global content rule. */
    --list-delay: 0.25s;
  }

  .page-head {
    margin-block-end: clamp(2rem, 5vh, 3rem);
  }

  .lead {
    font-size: var(--font-size-fluid-0);
    max-width: 52ch;
    margin-block-start: 0.75rem;
  }

  /* Entry choreography comes from the site-wide rules in global.css. */
</style>
