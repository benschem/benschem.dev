---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
---

<BaseLayout title="Posts — Ben Schembri" description="Writing by Ben Schembri.">
  <div class="posts-index">
    <header class="page-head">
      <p class="eyebrow">Writing</p>
      <h1>Posts</h1>
      <p class="lead">
        A collection of my thoughts on different topics related to software
        development.
      </p>
    </header>

    <PostList />
  </div>
</BaseLayout>

<style>
  .posts-index {
    max-width: 68ch;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
    padding-block: clamp(2.5rem, 8vh, 5rem);
  }

  .page-head {
    margin-block-end: clamp(2rem, 5vh, 3rem);
  }

  .eyebrow {
    font-family: var(--font-system-ui);
    font-size: var(--font-size-fluid--1);
    font-weight: 700;
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-block-end: 0.5rem;
  }

  .lead {
    font-size: var(--font-size-fluid-0);
    max-width: 52ch;
    margin-block-start: 0.75rem;
  }

  /* Matches the homepage hero stagger so navigating between the two feels
     continuous. Time-based, so opacity:0 only applies when it will animate. */
  @media (prefers-reduced-motion: no-preference) {
    .page-head > * {
      opacity: 0;
      animation: rise 0.7s cubic-bezier(0.21, 0.6, 0.35, 1) both;
    }
    .page-head > :nth-child(1) {
      animation-delay: 0.1s;
    }
    .page-head > :nth-child(2) {
      animation-delay: 0.2s;
    }
    .page-head > :nth-child(3) {
      animation-delay: 0.32s;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
