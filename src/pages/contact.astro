  },
];
---

<BaseLayout
  title="Connect with Ben Schembri"
  description="Ways to get in touch with or follow Ben Schembri on the web."
>
  <div class="connect">
    <header class="page-head">
      <h1>Send me a message</h1>
      <p class="lead">This form submits right into my email inbox.</p>
    </header>

    <ContactForm />

    <section class="studio" aria-labelledby="studio-heading">
      <h2 id="studio-heading">My web studio</h2>
      <p class="studio-lead">
        I build custom e-commerce stores for Australian fashion and lifestyle brands that have outgrown Shopify.
      </p>
      <p class="studio-lead">
        Plus I build a great marketing site - can't you tell?
      </p>
      <p class="studio-lead">
        See what I can do for you over at <a
          href="https://rocketzip.com.au"
          target="_blank"
          rel="noopener noreferrer">Rocketzip</a
        >.
      </p>
    </section>

    <section class="socials" aria-labelledby="socials-heading">
      <h2 id="socials-heading">This is me on socials</h2>
      <p class="socials-lead">
        I'm (not very active) on the usual suspects, pick your poison.
      </p>
      <ul class="links">
        {
          links.map(({ icon, label, href }) => (
            <li>
              <a href={href} target="_blank" rel="noopener noreferrer">
                <span class="badge" aria-hidden="true">
                  <svg
                    viewBox={icons[icon].viewBox}
                    fill="currentColor"
                    set:html={icons[icon].body}
                  />
                </span>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .connect {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
    padding-block: clamp(2.5rem, 8vh, 5rem);
  }

  .page-head {
    margin-block-end: 2.5rem;
  }

  .lead {
    font-size: var(--font-size-fluid-0);
    margin-block-start: 0.25rem;
    max-width: 48ch;
  }

  .links {
    display: grid;
    gap: 0.75rem;
  }

  /* The anchor stays a plain inline link so the global wavy underline and
     external ↗ behave exactly like body links. (A flex anchor blockifies the
     ::after arrow — it picks up the underline and the flex gap.) The badge is
     an atomic inline, so the underline skips it too. */

  /* Round badge echoing the header avatar's radial burst. */
  .badge {
    display: inline-grid;
    place-items: center;
    vertical-align: middle;
    margin-inline-end: 0.5rem;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: var(--ink-body);
    background: radial-gradient(
      circle at center,
      var(--burst-centre),
      var(--burst-mid)
    );
  }

  .badge svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .studio,
  .socials {
    margin-block-start: clamp(2.5rem, 7vh, 4rem);
  }

  .studio-lead,
  .socials-lead {
    font-size: var(--font-size-fluid-0);
    margin-block-end: 1.5rem;
    max-width: 48ch;
  }

  /* Six socials read better as a 2×3 grid. */
  .socials .links {
    grid-template-columns: repeat(2, 1fr);
    column-gap: 2rem;
  }

  @media (max-width: 36rem) {
    .socials .links {
      grid-template-columns: 1fr;
    }
  }

</style>
