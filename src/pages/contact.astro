  {
    icon: "github",
    label: "GitHub",
    href: "https://github.com/benschem",
  },
  {
    icon: "x",
    label: "X / Twitter",
    href: "https://x.com/benschem",
  },
  {
    icon: "instagram",
    label: "Instagram",
    href: "https://www.instagram.com/benschem/",
  },
  {
    icon: "facebook",
    label: "Facebook",
    href: "https://www.facebook.com/schembri.ben",
  },
  {
